# Copy to .env and fill in your own values.

OPENAI_API_KEY=sk-...

# Free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-usda-key

POSTGRES_USER=calorie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=calorie_tracker

# Must match the values above; docker-compose exposes Postgres on port 5433.
DATABASE_URL=postgresql://calorie:change-me@localhost:5433/calorie_tracker

# Optional: comma-separated origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
